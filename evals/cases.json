    {
      "id": "long-context",
      "prompt": "读取 long.txt。只报告文件开头的 START_MARK 和结尾的 END_MARK；若结果裁剪，不得声称已完整分析全文。",
      "fixtures": {
        "long.txt": {
          "repeat": "Synthetic filler line.\n",
          "count": 2000,
          "prefix": "START_MARK\n",
          "suffix": "END_MARK\n"
        }
      },
      "offline": {
        "actions": [
          {
            "tool": "read_file",
            "args": {
              "path": "long.txt"
            }
          }
