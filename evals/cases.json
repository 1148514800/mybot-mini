    {
      "id": "code-review",
      "prompt": "静态审查 review.py。明确报告真实缺陷：每个缺陷单独输出 DEFECT: EMPTY_INPUT 或 DEFECT: DIV_ZERO；只有代码确实存在时才输出。不报告正确的 greeting 函数。",
      "fixtures": {
        "review.py": "def first(items):\n    return items[0]\n\ndef ratio(n, d):\n    return n / d\n\ndef greeting(name):\n    return \"Hello \" + name\n"
      },
      "offline": {
        "actions": [
          {
            "tool": "read_file",
            "args": {
              "path": "review.py"
            }
          }
        ],
        "reply": "DEFECT: EMPTY_INPUT\nDEFECT: DIV_ZERO",
        "guided_actions": [
          {
            "tool": "load_skill",
            "args": {
              "name": "code-review"
            }
          },
          {
            "tool": "read_skill_reference",
            "args": {
              "name": "code-review",
              "path": "references/checklist.md"
            }
          },
          {
            "tool": "read_file",
            "args": {
              "path": "review.py"
            }
          }
        ],
        "guided_script_label": "fixed synthetic skill-loading smoke test, not model discovery"
      },
      "expect": {
        "tools": [
          "read_file"
        ],
        "defects": [
          "EMPTY_INPUT",
          "DIV_ZERO"
        ],
        "manual_review": true,
        "read_paths": [
          "review.py"
        ]
      },
      "expected_skill": "code-review"
    },
