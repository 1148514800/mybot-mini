    {
      "id": "multi-step",
      "prompt": "先列出文件，再读取 notes.txt，最后将项目名、语言、截止日和负责人写入 result.txt；请显示计划并执行。",
      "fixtures": {
        "notes.txt": "Project Orion uses Python. Deadline: Friday. Owner: Ada.\n"
      },
      "offline": {
        "actions": [
          {
            "tool": "create_plan",
            "args": {
              "steps": [
                "List and read source",
                "Write verified summary"
              ]
            }
          },
          {
            "tool": "update_plan",
            "args": {
              "step": 1,
              "status": "in_progress"
            }
          },
          {
            "tool": "list_files",
            "args": {
              "path": "."
            }
          },
          {
            "tool": "read_file",
            "args": {
              "path": "notes.txt"
            }
          },
          {
            "tool": "update_plan",
            "args": {
              "step": 1,
              "status": "completed"
            }
          },
          {
            "tool": "update_plan",
            "args": {
              "step": 2,
              "status": "in_progress"
            }
          },
          {
            "tool": "write_file",
            "args": {
              "path": "result.txt",
              "content": "Orion | Python | Friday | Ada\n"
            }
          },
          {
            "tool": "update_plan",
            "args": {
              "step": 2,
              "status": "completed"
            }
          }
        ],
        "reply": "Created result.txt"
      },
      "expect": {
        "tools": [
          "list_files",
          "read_file",
          "write_file"
