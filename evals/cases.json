          {
            "tool": "read_file",
            "args": {
              "path": "decisions.md"
            }
          },
          {
            "tool": "write_file",
            "args": {
              "path": "project-summary.json",
              "content": "{\n  \"project\": \"Harbor\",\n  \"release_date\": \"October 20\",\n  \"language\": \"Python\",\n  \"deployment\": \"local-only\",\n  \"telemetry\": \"disabled\",\n  \"owner\": \"Mira\",\n  \"budget_usd\": 500,\n  \"constraints\": [\n    \"no personal data uploads\",\n    \"CSV export required\"\n  ],\n  \"superseded\": [\n    \"September 30 release\",\n    \"October 10 release\",\n    \"JavaScript\",\n    \"public cloud\",\n    \"telemetry enabled\",\n    \"Leo owner\"\n  ]\n}\n"
            }
          }
        ],
        "reply": "Created project-summary.json",
        "guided_actions": [
          {
            "tool": "load_skill",
            "args": {
              "name": "file-summary"
            }
          },
          {
            "tool": "read_skill_reference",
            "args": {
              "name": "file-summary",
              "path": "references/checklist.md"
            }
          },
          {
            "tool": "read_file",
            "args": {
              "path": "requirements.md"
            }
          },
          {
            "tool": "read_file",
            "args": {
              "path": "meeting-notes.md"
            }
          },
          {
            "tool": "read_file",
            "args": {
              "path": "changelog.md"
            }
          },
          {
            "tool": "read_file",
            "args": {
              "path": "decisions.md"
            }
          },
          {
            "tool": "write_file",
            "args": {
              "path": "project-summary.json",
              "content": "{\n  \"project\": \"Harbor\",\n  \"release_date\": \"October 20\",\n  \"language\": \"Python\",\n  \"deployment\": \"local-only\",\n  \"telemetry\": \"disabled\",\n  \"owner\": \"Mira\",\n  \"budget_usd\": 500,\n  \"constraints\": [\n    \"no personal data uploads\",\n    \"CSV export required\"\n  ],\n  \"superseded\": [\n    \"September 30 release\",\n    \"October 10 release\",\n    \"JavaScript\",\n    \"public cloud\",\n    \"telemetry enabled\",\n    \"Leo owner\"\n  ]\n}\n"
            }
          }
        ],
        "guided_script_label": "fixed synthetic skill-loading smoke test, not model discovery"
      },
      "expect": {
        "tools": [
          "read_file",
          "write_file"
        ],
        "read_paths": [
