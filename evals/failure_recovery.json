    "metadata": {
      "category": "failure_recovery",
      "fake_empty_responses": 1,
      "fake_tools": [
        {
          "name": "read_file",
          "arguments": {"path": "status.txt"},
          "output": "ready"
        }
      ],
      "fake_output": "状态是 ready，任务已继续完成。"
    }
  }
