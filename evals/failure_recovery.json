  {
    "id": "recovery_003",
    "name": "Stop a repeated identical tool call",
    "input": "检查命令但不要无限重复",
    "expected_tools": ["exec"],
    "forbidden_tools": ["browser_eval"],
    "must_contain": ["已停止重复"],
    "must_not_contain": ["无限"],
    "max_steps": 5,
    "metadata": {
      "category": "failure_recovery",
      "fake_tools": [
        {"name": "exec", "arguments": {"command": "status"}, "output": "pending"},
        {"name": "exec", "arguments": {"command": "status"}, "output": "pending"},
        {"name": "exec", "arguments": {"command": "status"}, "output": "unused"}
      ],
      "fake_output": "已停止重复调用并结束检查。"
    }
  },
  {
    "id": "recovery_004",
    "name": "Recover after one empty model response",
    "input": "读取状态文件并继续完成",
    "expected_tools": ["read_file"],
    "forbidden_tools": ["exec"],
    "must_contain": ["ready"],
    "must_not_contain": ["空响应"],
