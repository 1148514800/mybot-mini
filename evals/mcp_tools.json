      "category": "mcp_tools",
      "fake_tools": [
        {
          "name": "mcp__demo__search",
          "arguments": {"query": "docs"},
          "output": "result",
          "runtime_metadata": {
            "tool_source": "mcp",
            "mcp_server": "demo",
            "mcp_tool_name": "search",
            "local_tool_name": "mcp__demo__search",
            "transport": "stdio",
            "protocol_version": "sdk-negotiated",
            "trust_annotations": true,
            "read_only_hint": true
          }
        }
      ],
      "fake_output": "外部搜索完成。"
    }
  },
