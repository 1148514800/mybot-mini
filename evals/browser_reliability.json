[
  {
    "id": "reliability_001",
    "name": "Recover one stale target through a fresh snapshot",
    "input": "打开页面并保存设置",
    "expected_tools": ["browser_open", "browser_click", "browser_snapshot", "browser_verify"],
    "expected_status": "success",
    "expected_tool_call_counts": {
      "browser_open": 1,
      "browser_click": 2,
      "browser_snapshot": 1,
      "browser_verify": 1
    },
    "expected_tool_execution_counts": {
      "browser_open": 1,
      "browser_click": 2,
      "browser_snapshot": 1,
      "browser_verify": 1
    },
    "expected_trace_metadata": {
      "error_type": ["stale_target"],
      "recovery_action": ["browser_snapshot"]
    },
    "must_contain": ["已保存"],
    "max_steps": 6,
    "metadata": {
      "category": "browser_reliability",
      "fake_tools": [
        {"name": "browser_open", "arguments": {}, "output": "opened"},
        {
          "name": "browser_click",
          "arguments": {"target": "e12"},
          "success": false,
          "error": "Ref e12 not found in current page snapshot",
          "result_metadata": {"error_type": "stale_target", "recoverable": true}
        },
        {"name": "browser_snapshot", "arguments": {}, "output": "button Save [ref=e44]"},
        {"name": "browser_click", "arguments": {"target": "e44"}, "output": "clicked"},
        {"name": "browser_verify", "arguments": {"text": "Saved"}, "output": "postcondition_met=true"}
      ],
      "fake_tool_batches": [
        [{"name": "browser_open", "arguments": {}, "output": "opened"}],
        [{"name": "browser_click", "arguments": {"target": "e12"}}],
        [{"name": "browser_click", "arguments": {"target": "e44"}}],
        [{"name": "browser_verify", "arguments": {"text": "Saved"}}]
      ],
      "fake_output": "设置已保存。"
    }
  },
  {
    "id": "reliability_002",
    "name": "Do not claim success after a failed final click",
    "input": "点击提交按钮完成表单",
    "expected_tools": ["browser_click"],
    "expected_status": "failed",
    "expected_tool_executions": 1,
    "must_contain": ["尚未完成"],
    "must_not_contain": ["已完成"],
    "max_steps": 2,
    "metadata": {
      "category": "browser_reliability",
      "fake_tools": [
        {
          "name": "browser_click",
          "arguments": {"target": "#submit"},
          "success": false,
          "error": "click failed",
          "result_metadata": {"error_type": "unknown", "recoverable": false}
        }
      ],
      "fake_output": "表单已完成。"
    }
  },
  {
    "id": "reliability_003",
    "name": "Require final action plus structured postcondition evidence",
    "input": "提交表单并确认保存结果",
    "expected_tools": ["browser_click", "browser_verify"],
    "expected_status": "success",
    "expected_tool_executions": 2,
    "must_contain": ["已完成"],
    "max_steps": 3,
    "metadata": {
      "category": "browser_reliability",
      "fake_tools": [
        {"name": "browser_click", "arguments": {"target": "#submit"}, "output": "clicked"},
        {"name": "browser_verify", "arguments": {"text": "Saved"}, "output": "postcondition_met=true"}
      ],
      "fake_output": "表单已完成并验证保存状态。"
    }
  },
  {
    "id": "reliability_004",
    "name": "Stop repeating the same browser syntax failure",
    "input": "查询页面目标",
    "expected_tools": ["browser_inspect"],
    "expected_status": "failed",
    "expected_tool_call_counts": {"browser_inspect": 2},
    "expected_tool_execution_counts": {"browser_inspect": 1},
    "expected_trace_metadata": {
      "error_type": ["tool_syntax_error", "budget_exceeded"],
      "budget_rule": ["non_recoverable_action_repeat"]
    },
    "must_contain": ["尚未完成"],
    "must_not_contain": ["已完成"],
    "max_steps": 4,
    "metadata": {
      "category": "browser_reliability",
      "fake_tools": [
        {
          "name": "browser_inspect",
          "arguments": {"selector": "["},
          "success": false,
          "error": "SyntaxError: invalid selector",
          "result_metadata": {"error_type": "tool_syntax_error", "recoverable": false}
        }
      ],
      "fake_response_sequence": [
        {"tools": [{"name": "browser_inspect", "arguments": {"selector": "["}}]},
        {"tools": [{"name": "browser_inspect", "arguments": {"selector": "["}}]},
        {"output": "已完成。"},
        {"output": "已完成。"}
      ]
    }
  },
  {
    "id": "reliability_005",
    "name": "Continue a corrected task without reopening or rereading Skill",
    "input": "打开页面并按浏览器 Skill 检查结果",
    "follow_up_inputs": ["你没有完成，继续"],
    "expected_tools": ["browser_open", "read_file", "browser_inspect"],
    "expected_status": "success",
    "expected_shared_task_id": true,
    "expected_tool_call_counts": {
      "browser_open": 2,
      "read_file": 2,
      "browser_inspect": 1
    },
    "expected_tool_execution_counts": {
      "browser_open": 1,
      "read_file": 1,
      "browser_inspect": 1
    },
    "must_contain": ["继续原任务"],
    "max_steps": 8,
    "metadata": {
      "category": "browser_reliability",
      "fake_tools": [
        {"name": "browser_open", "arguments": {}, "output": "opened"},
        {"name": "read_file", "arguments": {"path": "skills/playwright-cli/SKILL.md"}, "output": "skill"},
        {"name": "browser_inspect", "arguments": {"text": "Result"}, "output": "Result found"}
      ],
      "fake_response_sequence": [
        {"tools": [{"name": "browser_open", "arguments": {}}]},
        {"tools": [{"name": "read_file", "arguments": {"path": "skills/playwright-cli/SKILL.md"}}]},
        {"output": "初次检查结束。"},
        {"tools": [{"name": "browser_open", "arguments": {}}]},
        {"tools": [{"name": "read_file", "arguments": {"path": "skills/playwright-cli/SKILL.md"}}]},
        {"tools": [{"name": "browser_inspect", "arguments": {"text": "Result"}}]},
        {"output": "已复用上下文继续原任务。"}
      ]
    }
  }
]
