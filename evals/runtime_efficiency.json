[
  {
    "id": "efficiency_001",
    "name": "Use structured DOM inspection without arbitrary JavaScript",
    "input": "打开页面并查找消息输入框和发送按钮",
    "expected_tools": ["browser_open", "browser_snapshot", "browser_inspect"],
    "forbidden_tools": ["browser_eval"],
    "expected_policy_decisions": ["allow"],
    "expected_risk_levels": ["read"],
    "expected_tool_executions": 3,
    "expected_tool_call_counts": {
      "browser_open": 1,
      "browser_snapshot": 1,
      "browser_inspect": 1,
      "browser_eval": 0
    },
    "must_contain": ["结构化查询"],
    "max_steps": 4,
    "metadata": {
      "category": "runtime_efficiency",
      "fake_tools": [
        {"name": "browser_open", "arguments": {}, "output": "opened"},
        {"name": "browser_snapshot", "arguments": {}, "output": "message page"},
        {
          "name": "browser_inspect",
          "arguments": {"role": "textbox", "placeholder": "发送消息"},
          "output": "target=textarea[placeholder=发送消息]"
        }
      ],
      "fake_output": "已通过结构化查询找到消息输入框。"
    }
  },
  {
    "id": "efficiency_002",
    "name": "Resume clarification without reopening managed browser",
    "input": "打开抖音并确认候选好友",
    "follow_up_inputs": ["是"],
    "expected_tools": ["browser_open", "request_user_input", "browser_inspect"],
    "forbidden_tools": ["browser_eval"],
    "expected_tool_call_counts": {
      "browser_open": 1,
      "request_user_input": 1,
      "browser_inspect": 1
    },
    "expected_tool_execution_counts": {
      "browser_open": 1,
      "request_user_input": 1,
      "browser_inspect": 1
    },
    "expected_shared_task_id": true,
    "must_contain": ["继续原任务"],
    "max_steps": 4,
    "metadata": {
      "category": "runtime_efficiency",
      "fake_tools": [
        {"name": "browser_open", "arguments": {"url": "https://www.douyin.com"}, "output": "opened"},
        {
          "name": "request_user_input",
          "arguments": {"question": "找到的是食物爱西昂，是否就是这个好友？"},
          "output": "找到的是食物爱西昂，是否就是这个好友？"
        },
        {
          "name": "browser_inspect",
          "arguments": {"role": "textbox"},
          "output": "message textbox"
        }
      ],
      "fake_output": "已复用 managed_browser 继续原任务。"
    }
  },
  {
    "id": "efficiency_003",
    "name": "Resume clarification without reloading Skill",
    "input": "按照抖音 Skill 给好友发送消息",
    "follow_up_inputs": ["食物爱西昂"],
    "expected_tools": ["read_file", "request_user_input", "browser_inspect"],
    "forbidden_tools": ["browser_eval"],
    "expected_tool_call_counts": {
      "read_file": 1,
      "request_user_input": 1,
      "browser_inspect": 1
    },
    "expected_tool_execution_counts": {
      "read_file": 1,
      "request_user_input": 1,
      "browser_inspect": 1
    },
    "expected_shared_task_id": true,
    "must_contain": ["没有重复读取 Skill"],
    "max_steps": 4,
    "metadata": {
      "category": "runtime_efficiency",
      "fake_tools": [
        {
          "name": "read_file",
          "arguments": {"path": "skills/douyin-skills/SKILL.md"},
          "output": "douyin skill instructions"
        },
        {
          "name": "request_user_input",
          "arguments": {"question": "请确认好友昵称"},
          "output": "请确认好友昵称"
        },
        {
          "name": "browser_inspect",
          "arguments": {"text": "食物爱西昂"},
          "output": "one matching friend"
        }
      ],
      "fake_output": "已继续任务，没有重复读取 Skill。"
    }
  },
  {
    "id": "efficiency_004",
