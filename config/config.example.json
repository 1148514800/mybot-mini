{
  "coding": {
    "enabled": false,
    "patch_mode": "off",
    "command": {
      "mode": "off",
      "timeout_seconds": 30,
      "max_output_bytes": 32768
    },
    "autonomy": {
      "enabled": false,
      "max_model_requests": 20,
      "max_tool_calls": 48,
      "max_patch_write_attempts": 3,
      "max_command_attempts": 6,
      "max_no_progress": 3,
      "max_task_seconds": 300
    },
    "git_workflow": {
      "enabled": false,
      "undo_enabled": false,
      "max_files": 24,
      "max_journal_bytes": 8388608,
      "max_review_chars": 20000
    }
  },
  "debug": false,
  "session": {
    "max_turns": 6,
    "persist": false,
    "path": "./.mybot_state/session.json"
  },
  "llm": {
    "provider": "siliconflow",
    "max_completion_tokens": 20000,
    "request_timeout_seconds": 60,
    "max_react_steps": 10,
    "providers": {
      "siliconflow": {
        "api_key": "YOUR_SILICONFLOW_API_KEY",
        "base_url": "https://api.siliconflow.cn/v1",
        "model": "Qwen/Qwen3-235B-A22B-Instruct-2507"
      },
      "openai": {
        "api_key": "YOUR_OPENAI_API_KEY",
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-4.1-mini"
      }
    }
  },
  "workspace": {
    "path": "./workspace"
  },
  "context": {
    "enabled": false,
    "max_chars": 40000,
    "recent_turns": 2,
    "summary_max_chars": 1500,
    "tool_result_max_chars": 4000,
    "token_budget": {
      "mode": "legacy_chars",
      "input_limit": 16000,
      "model_windows": {}
    },
    "compaction": {
      "mode": "deterministic",
      "allow_extra_requests": false,
      "max_calls": 1,
      "input_tokens": 12000,
      "output_tokens": 1200,
      "timeout_seconds": 15,
      "on_failure": "deterministic"
    }
  },
  "skills": {
    "enabled": false,
    "path": "./skills"
  },
  "mcp": {
    "enabled": false,
    "discovery": {
      "enabled": false,
      "retrieval_mode": "literal",
      "routing_mode": "manual",
      "selection_policy": "legacy",
      "eager_tool_threshold": 4,
      "preselect_limit": 3,
      "max_active_tools": 4,
      "max_active_schema_chars": 12000,
      "search_limit": 5
    },
    "servers": {
      "demo": {
        "command": "uv",
        "args": [
          "run",
          "python",
          "-m",
          "scripts.mcp_demo_server"
        ],
        "allowed_tools": [
          "add",
          "echo",
          "save_note",
          "read_note",
          "delete_note"
        ],
        "timeout_seconds": 10,
        "tool_policies": {
          "add": "allow",
          "echo": "allow",
          "save_note": "confirm",
          "read_note": "allow",
          "delete_note": "confirm"
        },
        "transport": "stdio"
      },
      "demo-http": {
        "transport": "streamable_http",
        "url": "http://127.0.0.1:8765/mcp",
        "auth": {
          "type": "none"
        },
        "allowed_tools": [
          "add",
          "echo",
          "save_note",
          "read_note",
          "delete_note"
        ],
        "tool_policies": {
          "add": "allow",
          "echo": "allow",
          "save_note": "confirm",
          "read_note": "allow",
          "delete_note": "confirm"
        },
        "timeout_seconds": 10
      }
    }
  },
  "web": {
    "streaming": {
      "enabled": false
    },
    "steer": {
      "enabled": false
    }
  }
}
